# ============================================================
# YOUPI PG — PRODUCTION ENVIRONMENT CONFIGURATION
# Default: Localhost Development / Clean Commercial Copy
# ============================================================

NODE_ENV=development

# --- SERVICE PORTS ---
CONTROL_CENTER_PORT=8090
PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001
HELP_PORTAL_PORT=3000
GMAIL_OBSERVER_PORT=6003
SMS_OBSERVER_PORT=6002
COIN_STORE_PORT=5000

# --- SERVICE BASE URLS (DEFAULT LOCALHOST) ---
BASE_PAYMENT_API_URL=http://localhost:6100
BASE_CHECKOUT_URL=http://localhost:7000
BASE_ADMIN_URL=http://localhost:6001
BASE_HELP_URL=http://localhost:3005
BASE_DEMO_URL=http://localhost:5000

# --- DATABASE CONFIGURATION ---
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/youpi_pg.sqlite

# --- CRYPTOGRAPHIC SECRETS ---
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=demo_super_secret_jwt_key_min_32_chars_long_for_security_change_me
INITIAL_ADMIN_EMAIL=admin@store.local
INITIAL_ADMIN_PASSWORD=171088

# --- TIMING & QUEUE ENGINE CONSTANTS ---
PAYMENT_ACTIVE_WINDOW_MS=300000
PAYMENT_PROCESSING_WINDOW_MS=30000
LATE_OBSERVATION_WINDOW_MS=1800000

# --- ANDROID OBSERVER SECURITY ---
ANDROID_ENROLLMENT_SECRET=youpi_android_enroll_demo_secret_key_change_me
ANDROID_HEARTBEAT_TIMEOUT_MS=180000

# --- GMAIL OBSERVER CONFIGURATION ---
GMAIL_CLIENT_ID=demo-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=demo-gmail-secret
GMAIL_REDIRECT_URI=http://localhost:6100/oauth/callback
GMAIL_POLL_INTERVAL_MS=5000

# --- SMS / GOOGLE MESSAGES OBSERVER ---
SMS_OBSERVER_POLL_INTERVAL_MS=3000

# --- WEBHOOK ENGINE ---
WEBHOOK_MAX_RETRIES=5
WEBHOOK_INITIAL_BACKOFF_MS=5000

# --- WHITE-LABEL BRANDING ---
DEFAULT_APP_NAME="YOUPI PG"
DEFAULT_PRIMARY_COLOR="#2563eb"
DEFAULT_SUPPORT_EMAIL="support@example.com"
